{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/dashboard/**",
              "components/forms/**",
              "components/layout/**",
              "components/panels/**",
              "components/provenance/**",
              "components/status/**",
              "components/surfaces/**",
              "components/typography/**",
              "ui_kits/dashboard/**",
              "ui_kits/switchyards/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:HelveticaNeue|HelveticaNeue-Light|HelveticaNeue-Condensed|IBM Plex Mono|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: HelveticaNeue, HelveticaNeue-Light, HelveticaNeue-Condensed, IBM Plex Mono, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccentCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|children|key|ref|className|style|children)$/]",
        "message": "<AccentCard> doesn't accept that prop. Declared props: variant, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccentCard'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:accent|outline)$/]",
        "message": "<AccentCard> variant must be one of 'accent' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppShell'] > JSXAttribute > JSXIdentifier[name!=/^(?:tier|rail|top|tabs|header|drawer|drawerWidth|drawerTitle|onDrawerClose|width|ground|children|key|ref|className|style|children)$/]",
        "message": "<AppShell> doesn't accept that prop. Declared props: tier, rail, top, tabs, header, drawer, drawerWidth, drawerTitle, onDrawerClose, width, ground, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppShell'] > JSXAttribute[name.name='tier'] > Literal[value!=/^(?:auto|phone|tablet|desktop)$/]",
        "message": "<AppShell> tier must be one of 'auto' | 'phone' | 'tablet' | 'desktop'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppShell'] > JSXAttribute[name.name='width'] > Literal[value!=/^(?:page|full)$/]",
        "message": "<AppShell> width must be one of 'page' | 'full'."
