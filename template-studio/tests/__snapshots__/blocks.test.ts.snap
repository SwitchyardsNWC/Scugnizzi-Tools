{% module "hero_image" path="@hubspot/image_email", label="Hero image", alignment="center", img={ "src": "", "alt": "", "width": 560 }, export_to_template_context=True %}{% if widget_data.hero_image.img.src %}<div class="hse-section sy-bg-011272" style="padding:0; max-width:600px; margin:0 auto; background-color:#011272" bgcolor="#011272"><!--[if gte mso 9]><table align="center" border="0" cellpadding="0" cellspacing="0" role="presentation" width="600" style="width:600px" bgcolor="#011272"><tbody><tr><td valign="top"><![endif]--><div class="hse-column-container" style="min-width:280px; max-width:600px; margin:0 auto"><!--[if (mso)|(IE)]><table align="center" style="width:600px;" cellpadding="0" cellspacing="0" role="presentation" width="600"><tr><td valign="top" style="width:600px;"><![endif]--><div class="hse-column hse-size-12"><table class="hse-image-wrapper" role="presentation" width="100%" cellpadding="0" cellspacing="0"><tbody><tr><td class="hs_padded" align="center" valign="top" style="font-family:Helvetica, Arial, sans-serif; word-break:break-word; text-align:center; padding:10px 20px 10px; font-size:0px">{% if widget_data.hero_image.link %}<a href="{{ widget_data.hero_image.link }}" target="_blank" style="color:#00a4bd">{% endif %}<img alt="{{ widget_data.hero_image.img.alt }}" src="{{ widget_data.hero_image.img.src }}" style="outline:none; text-decoration:none; border:none; max-width:100%; font-size:16px" width="560" align="middle">{% if widget_data.hero_image.link %}</a>{% endif %}</td></tr></tbody></table></div><!--[if (mso)|(IE)]></td></tr></table><![endif]--></div><!--[if gte mso 9]></td></tr></tbody></table><![endif]--></div>{% endif %}



--- phone ---
/* Phone sizes for headings and anything typed in the rich text editor. */
@media only print, only screen and (max-width:639px) {
  .sy-h1, .sy-rich h1 { font-size:30px !important } .sy-h2, .sy-rich h2 { font-size:20px !important } .sy-h3, .sy-rich h3 { font-size:17px !important } .sy-h4, .sy-rich h4 { font-size:15px !important } .sy-h5, .sy-rich h5 { font-size:14px !important } .sy-h6, .sy-rich h6 { font-size:12px !important }
  .sy-rich p, .sy-rich li, .sy-rich blockquote { font-size:17px !important }"
`;

