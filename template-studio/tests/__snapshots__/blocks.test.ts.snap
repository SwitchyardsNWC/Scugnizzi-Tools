// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`button > renders on the cream theme 1`] = `
"<div id="hs_cos_wrapper_main">

{% text "button_text" label="Button text (blank to hide)", value='GO', export_to_template_context=True %}{% text "button_link" label="Button link", value='https://www.switchyards.com/', export_to_template_context=True %}{% if widget_data.button_text.value|trim %}<div class="hse-section" style="padding:0; max-width:600px; margin:0 auto"><div class="hse-column-container sy-bg-f7f6f3" style="min-width:280px; max-width:600px; margin:0 auto; background-color:#f7f6f3" bgcolor="#f7f6f3"><!--[if (mso)|(IE)]><table align="center" style="width:600px;" cellpadding="0" cellspacing="0" role="presentation" width="600" bgcolor="#f7f6f3"><tr><td valign="top" style="width:600px;"><![endif]--><div class="hse-column hse-size-12"><table role="presentation" cellpadding="0" cellspacing="0" width="100%"><tbody><tr><td class="hs_padded" style="font-family:Helvetica, Arial, sans-serif; font-size:18px; word-break:break-word; padding:10px 20px 10px"><table align="center" border="0" cellpadding="0" cellspacing="0" role="presentation" style="border-collapse:separate!important"><tbody><tr><td class="sy-btn sy-bg-f7f6f3 sy-text-d10000 sy-link-d10000" align="center" valign="middle" bgcolor="#f7f6f3" style="font-family:Helvetica, Arial, sans-serif; font-size:18px; word-break:break-word; border-radius:25px; cursor:auto; background-color:#f7f6f3; border:2px solid #d10000; box-sizing:border-box; mso-padding-alt:12px 18px"><a href="{{ widget_data.button_link.value }}" target="_blank" style="color:#d10000; font-size:16px; font-family:Helvetica,Arial,sans-serif; Margin:0; text-transform:none; letter-spacing:0px; text-decoration:none; padding:12px 18px; display:block"><strong style="color:#d10000; font-weight:bold; text-decoration:none; font-style:normal">{{ widget_data.button_text.value }}</strong></a></td></tr></tbody></table></td></tr></tbody></table></div><!--[if (mso)|(IE)]></td></tr></table><![endif]--></div></div>{% endif %}



--- phone ---
/* Phone sizes for headings and anything typed in the rich text editor. */
@media only print, only screen and (max-width:639px) {
  .sy-h1, .sy-rich h1 { font-size:30px !important } .sy-h2, .sy-rich h2 { font-size:20px !important } .sy-h3, .sy-rich h3 { font-size:17px !important } .sy-h4, .sy-rich h4 { font-size:15px !important } .sy-h5, .sy-rich h5 { font-size:14px !important } .sy-h6, .sy-rich h6 { font-size:12px !important }
  .sy-rich p, .sy-rich li, .sy-rich blockquote { font-size:17px !important }"
`;

