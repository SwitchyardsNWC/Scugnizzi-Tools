exports[`legal > renders on the cream theme 1`] = `
"<div id="hs_cos_wrapper_main">

<div class="hse-section" id="section-legal" style="padding:0; max-width:600px; margin:0 auto"><div class="hse-column-container sy-bg-f7f6f3" style="min-width:280px; max-width:600px; margin:0 auto; background-color:#f7f6f3" bgcolor="#f7f6f3"><!--[if (mso)|(IE)]><table align="center" style="width:600px;" cellpadding="0" cellspacing="0" role="presentation" width="600" bgcolor="#f7f6f3"><tr><td valign="top" style="width:600px;"><![endif]--><div class="hse-column hse-size-12"><table role="presentation" cellpadding="0" cellspacing="0" width="100%"><tbody><tr><td style="font-family:Helvetica, Arial, sans-serif; font-size:18px; word-break:break-word; padding:0px 20px 0px 0px"><table role="presentation" class="hse-footer hse-secondary" width="100%" cellpadding="0" cellspacing="0" style="font-family:Helvetica, Arial, sans-serif; font-size:12px; line-height:135%; margin-bottom:0; padding:0"><tbody><tr><td align="left" valign="top" style="font-family:Helvetica, Arial, sans-serif; font-size:18px; color:#011272; word-break:break-word; text-align:left; margin-bottom:0; line-height:135%; padding:10px 20px" class="hs_padded sy-text-011272 sy-link-d10000"><p style="margin:0; line-height:115%; color:#011272; font-weight:bold; font-size:12px"><span style="font-size:16px">{{ site_settings.company_name }}</span><br><a href="https://www.google.com/maps/search/?api=1&amp;query={{ (site_settings.company_street_address_1 ~ ", " ~ site_settings.company_city ~ ", " ~ site_settings.company_state ~ " " ~ site_settings.company_zip)|urlencode }}" target="_blank" style="color:#011272 !important; text-decoration:none !important">{{ site_settings.company_street_address_1 }}{% if site_settings.company_street_address_2 %} {{ site_settings.company_street_address_2 }}{% endif %}, {{ site_settings.company_city }}, {{ site_settings.company_state }}&nbsp;{{ site_settings.company_zip }}</a></p><div style="line-height:115%; font-size:12px; color:#011272"><p style="margin:0; line-height:115%; font-size:12px; color:#011272; font-weight:normal">A note.</p></div><p style="margin:0; line-height:100%">&nbsp;</p><p style="margin:0"><span style="color:#011272; font-size:12px"><a href="{{ unsubscribe_link_all }}" style="color:#d10000" data-unsubscribe="true" target="_blank">Unsubscribe</a></span><br><a href="{{ unsubscribe_link }}" style="color:#d10000" data-unsubscribe="true" target="_blank"><span style="font-size:12px">Manage Preferences</span></a></p></td></tr></tbody></table></td></tr></tbody></table></div><!--[if (mso)|(IE)]></td></tr></table><![endif]--></div></div>



--- phone ---
/* Phone sizes for headings and anything typed in the rich text editor. */
@media only print, only screen and (max-width:639px) {
  .sy-h1, .sy-rich h1 { font-size:30px !important } .sy-h2, .sy-rich h2 { font-size:20px !important } .sy-h3, .sy-rich h3 { font-size:17px !important } .sy-h4, .sy-rich h4 { font-size:15px !important } .sy-h5, .sy-rich h5 { font-size:14px !important } .sy-h6, .sy-rich h6 { font-size:12px !important }
  .sy-rich p, .sy-rich li, .sy-rich blockquote { font-size:17px !important }"
`;

